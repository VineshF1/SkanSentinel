# Copy this file to ".env" and fill in real values. ".env" is git-ignored.
# Next.js loads ".env" automatically on boot (dev and production).

# Required. Login password for the dashboard and all admin APIs.
# The server refuses to start if this is empty. Use a long random value.
ADMIN_PASSWORD=change-me-to-a-long-random-secret

# "1" seeds 4 fake monitors, shows the demo control bar, and enables the
# demo alert sink (alerts are marked delivered, no network calls happen).
# "0" (or unset) is production mode: empty dashboard, no demo routes.
DEMO_MODE=0

# Where the SQLite database file lives. Examples:
#   Local Windows:  ./data/production.db
#   Docker:         /app/data/skansentinel.db  (mount a volume there)
DATABASE_PATH=./data/production.db

# "1" allows http and localhost webhook URLs. Local testing only.
# Production must stay "0" (https + public hosts only).
ALLOW_PRIVATE_WEBHOOKS=0
